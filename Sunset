local StyleTemplates = {
	Default = BuildDefaultStyle(),
	SmallLight = BuildSmallLightStyle(),
}

local function EvaluateNumberSequence(sequence, time)
	local keypoints = sequence.Keypoints
	if #keypoints == 1 then
		return keypoints[1].Value
	end
	time = math.clamp(time, 0, 1)
	for index = 1, #keypoints - 1 do
		local current = keypoints[index]
		local nextPoint = keypoints[index + 1]
		if time >= current.Time and time <= nextPoint.Time then
			local span = nextPoint.Time - current.Time
			local alpha = span > 0 and (time - current.Time) / span or 0
			return current.Value + (nextPoint.Value - current.Value) * alpha
		end
	end
	return keypoints[#keypoints].Value
end

local function EvaluateFadeValue(value, time)
	if typeof(value) == "number" then
		return value
	elseif typeof(value) == "NumberSequence" then
		return EvaluateNumberSequence(value, time)
	end
	return nil
end

local function RemapColorSequence(sequence, blendColor, blendAmount)
	local keypoints = {}
	for _, keypoint in ipairs(sequence.Keypoints) do
		local blended = keypoint.Value:Lerp(blendColor, blendAmount)
		table.insert(keypoints, ColorSequenceKeypoint.new(keypoint.Time, blended))
	end
	return ColorSequence.new(keypoints)
end

local function GetPositionAttribute(value, fallback)
	if typeof(value) == "Vector3" then
		return Vector2.new(value.X, value.Y)
	elseif typeof(value) == "Vector2" then
		return value
	end
	return fallback
end

local function CalculateObstruction(camera, part)
	local sampleCount = math.max(1, LensFlareConfig.RaycastSamples)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = {part}
	raycastParams.IgnoreWater = true

	local origin = camera.CFrame.Position
	local basePosition = part.Position
	local spread = part.Size * 0.5

	local visibleCount = 0
	for sampleIndex = 1, sampleCount do
		local offset = Vector3.new(0, 0, 0)
		if sampleIndex > 1 then
			offset = Vector3.new(
				(math.random() - 0.5) * spread.X,
				(math.random() - 0.5) * spread.Y,
				(math.random() - 0.5) * spread.Z
			)
		end
		local targetPosition = basePosition + offset
		local result = workspace:Raycast(origin, targetPosition - origin, raycastParams)
		if not result then
			visibleCount += 1
		end
	end

	return visibleCount / sampleCount
end

local LensFlare = {}
LensFlare.__index = LensFlare

function LensFlare.new(camera, flareStyle, part)
	assert(typeof(camera) == "Instance" and camera:IsA("Camera"), "camera must be a Camera instance")
	assert(typeof(flareStyle) == "string", "flareStyle must be a string")
	assert(typeof(part) == "Instance" and part:IsA("BasePart"), "part must be a BasePart instance")

	local self = setmetatable({}, LensFlare)
	self.Camera = camera
	self.FlareStyle = flareStyle
	self.Part = part
	self.Enabled = true
	self.Alpha = 0
	self.EmitterData = {}

	self.Rig = Instance.new("Part")
	self.Rig.Name = "LensFlareRig"
	self.Rig.Anchored = true
	self.Rig.CanCollide = false
	self.Rig.CanQuery = false
	self.Rig.CanTouch = false
	self.Rig.CastShadow = false
	self.Rig.Massless = true
	self.Rig.Transparency = 1
	self.Rig.Size = Vector3.new(0.05, 0.05, 0.05)
	self.Rig.Parent = workspace

	local styleEmitters = StyleTemplates[flareStyle]
	if not styleEmitters then
		warn("LensFlare style '" .. flareStyle .. "' was not found")
	else
		for _, emitter in ipairs(styleEmitters) do
			local clonedEmitter = emitter:Clone()
			clonedEmitter.Lifetime = NumberRange.new(LensFlareConfig.ParticleLifetime)

			local attachment = Instance.new("Attachment")
			attachment.Name = clonedEmitter.Name
			attachment.Parent = self.Rig
			clonedEmitter.Parent = attachment

			table.insert(self.EmitterData, {
				Emitter = clonedEmitter,
				Attachment = attachment,
				Position = GetPositionAttribute(clonedEmitter:GetAttribute("Position"), Vector2.new(1, 1)),
				PositionMult = clonedEmitter:GetAttribute("PositionMult") or 1,
				Rotates = clonedEmitter:GetAttribute("Rotates") or false,
				ColorBlend = clonedEmitter:GetAttribute("ColorBlend") or 0,
				BaseColor = clonedEmitter.Color,
			})
		end
	end

	self.Connection = RunService.Heartbeat:Connect(function()
		if self.Enabled then
			self:Update()
		end
	end)

	return self
end

function LensFlare:Update()
	local part = self.Part
	if not part or not part.Parent then
		self:Destroy()
		return
	end

	local camera = self.Camera
	local viewportSize = camera.ViewportSize
	local sourcePosition = part.Position
	local cameraPosition = camera.CFrame.Position

	local screenPoint = camera:WorldToViewportPoint(sourcePosition)
	local behindCamera = screenPoint.Z <= 0

	local toSource = sourcePosition - cameraPosition
	local viewAngle = 0
	if toSource.Magnitude > 0.001 then
		viewAngle = math.acos(math.clamp(camera.CFrame.LookVector:Dot(toSource.Unit), -1, 1))
	end

	local verticalFov = math.rad(camera.FieldOfView)
	local aspectRatio = viewportSize.X / viewportSize.Y
	local diagonalFov = 2 * math.atan(math.tan(verticalFov * 0.5) * math.sqrt(1 + aspectRatio * aspectRatio))
	local angleAlpha = 1 - math.clamp(viewAngle / (diagonalFov * 0.5), 0, 1)

	local distanceAttribute = part:GetAttribute("LensFlareDistance") or 0
	local distanceAlpha = 1
	if distanceAttribute > 0 then
		distanceAlpha = 1 - math.clamp(toSource.Magnitude / distanceAttribute, 0, 1)
	end

	local obstructionAlpha = CalculateObstruction(camera, part)
	local strengthAttribute = part:GetAttribute("LensFlareStrength") or 1

	self.Alpha = behindCamera and 0 or (angleAlpha * distanceAlpha * obstructionAlpha * strengthAttribute)

	if self.Alpha <= 0.001 then
		return
	end

	local screenCenter = Vector2.new(viewportSize.X, viewportSize.Y) * 0.5
	local sourceScreen = Vector2.new(screenPoint.X, screenPoint.Y)
	local screenOffset = sourceScreen - screenCenter
	local fadeTime = 1 - angleAlpha

	for _, data in ipairs(self.EmitterData) do
		local emitter = data.Emitter
		local position = GetPositionAttribute(emitter:GetAttribute("Position"), data.Position)
		local positionMult = emitter:GetAttribute("PositionMult") or data.PositionMult
		local rotatesValue = emitter:GetAttribute("Rotates")
		if rotatesValue == nil then
			rotatesValue = data.Rotates
		end
		local colorBlend = emitter:GetAttribute("ColorBlend") or data.ColorBlend

		local emitterOffset = Vector2.new(screenOffset.X * position.X, screenOffset.Y * position.Y) * positionMult
		local emitterScreen = screenCenter + emitterOffset
		local ray = camera:ViewportPointToRay(emitterScreen.X, emitterScreen.Y)
		data.Attachment.WorldPosition = ray.Origin + ray.Direction.Unit * LensFlareConfig.FlareDepth

		if rotatesValue then
			emitter.Rotation = NumberRange.new(-math.deg(math.atan2(emitterOffset.Y, emitterOffset.X)))
		else
			emitter.Rotation = NumberRange.new(0)
		end

		local sizeValue = EvaluateFadeValue(emitter:GetAttribute("SizeFade"), fadeTime)
		if sizeValue then
			emitter.Size = NumberSequence.new(sizeValue)
		end

		local squashValue = EvaluateFadeValue(emitter:GetAttribute("SquashFade"), fadeTime)
		if squashValue then
			emitter.Squash = NumberSequence.new(squashValue)
		end

		local transparencyValue = EvaluateFadeValue(emitter:GetAttribute("TransparencyFade"), fadeTime) or 0
		local finalTransparency = 1 - ((1 - transparencyValue) * self.Alpha)
		emitter.Transparency = NumberSequence.new(math.clamp(finalTransparency, 0, 1))

		if colorBlend > 0 then
			emitter.Color = RemapColorSequence(data.BaseColor, part.Color, colorBlend)
		else
			emitter.Color = data.BaseColor
		end

		emitter:Emit(1)
	end
end

function LensFlare:Destroy()
	if self.Connection then
		self.Connection:Disconnect()
		self.Connection = nil
	end
	if self.Rig then
		self.Rig:Destroy()
		self.Rig = nil
	end
end


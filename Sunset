local function CreateEmitter(name, colorSequence, attributes)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Enabled = false
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(0)
	emitter.RotSpeed = NumberRange.new(0)
	emitter.Lifetime = NumberRange.new(0.05)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.ZOffset = -5
	emitter.Orientation = Enum.ParticleOrientation.FacingCamera
	emitter.Color = colorSequence

	for attributeName, attributeValue in pairs(attributes) do
		emitter:SetAttribute(attributeName, attributeValue)
	end

	return emitter
end


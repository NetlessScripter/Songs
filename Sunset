local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

-- Figures out if the player is near an edge of the part beneath them.
-- Returns nil if not grounded, not near an edge, or off the part entirely.
local function getEdgeInfo(hrp)
    local result = workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0), rayParams)
    if not result or not result.Instance or not result.Instance:IsA("BasePart") then
        return nil
    end

    local part = result.Instance
    local localPos = part.CFrame:PointToObjectSpace(hrp.Position)
    local halfSize = part.Size / 2

    -- Bail if we're not actually within the part's footprint
    if math.abs(localPos.X) > halfSize.X + FOOTPRINT_SLOP
        or math.abs(localPos.Z) > halfSize.Z + FOOTPRINT_SLOP then
        return nil
    end

    local distPosX = halfSize.X - localPos.X
    local distNegX = halfSize.X + localPos.X
    local distPosZ = halfSize.Z - localPos.Z
    local distNegZ = halfSize.Z + localPos.Z

    local minDist = math.min(distPosX, distNegX, distPosZ, distNegZ)
    if minDist > EDGE_THRESHOLD then
        return nil
    end

    local edgeLocalPos, localNormal
    if minDist == distPosX then
        edgeLocalPos = Vector3.new(halfSize.X, localPos.Y, localPos.Z)
        localNormal = Vector3.new(1, 0, 0)
    elseif minDist == distNegX then
        edgeLocalPos = Vector3.new(-halfSize.X, localPos.Y, localPos.Z)
        localNormal = Vector3.new(-1, 0, 0)
    elseif minDist == distPosZ then
        edgeLocalPos = Vector3.new(localPos.X, localPos.Y, halfSize.Z)
        localNormal = Vector3.new(0, 0, 1)
    else
        edgeLocalPos = Vector3.new(localPos.X, localPos.Y, -halfSize.Z)
        localNormal = Vector3.new(0, 0, -1)
    end

    return {
        part = part,
        worldPos = part.CFrame:PointToWorldSpace(edgeLocalPos),
        outwardDir = part.CFrame:VectorToWorldSpace(localNormal).Unit,
    }
end

-- Plays the leap anim and swallows every other Animator6D call until it
-- finishes (Animation.Completed) or LEAP_LOCK_TIMEOUT passes, whichever is first.
local function unlockAnims(id)
    if id ~= leapLockId or not realAnimator6D then return end
    getgenv().Animator6D = realAnimator6D
    realAnimator6D = nil
end

local function playLeapAnim()
    local play = realAnimator6D or getgenv().Animator6D
    if not leapAnimData or not play then return end

    -- The module never clears a finished anim, so on the 2nd play it "stops" the
    -- old one AFTER suppressing Animate, and that old completion callback turns
    -- Animate back on mid-leap (default anims fight the leap = weird pose).
    -- Clearing it first makes that happen harmlessly before the new anim starts.
    if getgenv().Animator6DStop then
        pcall(getgenv().Animator6DStop)
    end

    leapLockId += 1
    local id = leapLockId

    if not realAnimator6D then
        realAnimator6D = play
        getgenv().Animator6D = function() end
    end

    local conn
    conn = getgenv().Animation.Completed:Connect(function()
        conn:Disconnect()
        unlockAnims(id)
    end)
    task.delay(LEAP_LOCK_TIMEOUT, function()
        conn:Disconnect()
        unlockAnims(id)
    end)

    if not pcall(play, leapAnimData, 1, false) then
        conn:Disconnect()
        unlockAnims(id)
    end
end

local function performLeap()
    local info = currentEdgeInfo
    local character = player.Character
    if not info or not character then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    leapButton.Visible = false
    currentEdgeInfo = nil

    -- v = sqrt(2 * g * h) gets us exactly enough vertical speed to apex at h studs
    local verticalSpeed = math.sqrt(2 * workspace.Gravity * LEAP_HEIGHT)

    -- Launch the direction the player is actually looking (flattened to the
    -- horizontal plane), not the part's edge normal - keeps shift lock aiming
    -- and normal camera aiming both behaving the way you'd expect.
    local camera = workspace.CurrentCamera
    local lookVector = camera and camera.CFrame.LookVector or hrp.CFrame.LookVector
    local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
    local launchDir = flatLook.Magnitude > 0.001 and flatLook.Unit or info.outwardDir

    if TELEPORT_TO_EDGE then
        hrp.CFrame = CFrame.lookAt(info.worldPos, info.worldPos + launchDir)
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
    hrp.AssemblyLinearVelocity = (launchDir * FORWARD_BOOST) + Vector3.new(0, verticalSpeed, 0)

    playLeapAnim()

    for _, soundId in ipairs(LEAP_SOUND_IDS) do
        local sound = Instance.new("Sound")
        sound.SoundId = soundId
        sound.Volume = 1
        sound.Parent = hrp
        sound.Ended:Connect(function()
            sound:Destroy()
        end)
        sound:Play()
    end
end


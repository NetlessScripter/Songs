--[[
	GraphicsModule.lua

	Quality preset API for the Sunset_3 lighting script. Load it AFTER Sunset_3
	has run, the same way the rain module is loaded:

		local graphicsAPI = loadstring(game:HttpGet("<raw url of this file>"))()
		graphicsAPI:SetQuality("Medium")

	It also registers itself as _G.GraphicsAPI (and getgenv().GraphicsAPI when
	available), so any other script can call it without needing the return value:

		_G.GraphicsAPI:SetQuality("Performance")
		_G.GraphicsAPI:SetClouds("Max")
		_G.GraphicsAPI:SetEffectEnabled("Bloom", false)

	Use colon calls (graphicsAPI:Method()), same as rainAPI:Disable().

	Max is Sunset_3's current look. Loading this module changes nothing by itself.
	Every value in the presets is a fixed literal, so edit them in place, either
	here or live through graphicsAPI.Presets.<Category>.<Quality>.<Property>.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

-- ===== RE-EXECUTION CLEANUP =====
-- If an older copy is already registered, remember its quality, tear it down,
-- and reapply that quality once this copy is built.

local environment = getgenv and getgenv() or _G
local previousQuality = nil

do
	local oldAPI = environment.GraphicsAPI or _G.GraphicsAPI
	if oldAPI then
		previousQuality = oldAPI.CurrentQuality
		pcall(oldAPI.Destroy, oldAPI)
	end
end


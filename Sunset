local categoryOrder = { "Lighting", "Effects", "Atmosphere", "Clouds", "LensFlare", "RobloxQuality" }

local effectClassNames = {
	ColorCorrection = "ColorCorrectionEffect",
	SunRays = "SunRaysEffect",
	Bloom = "BloomEffect",
	DepthOfField = "DepthOfFieldEffect",
}

-- Sunset_3 clones the cloud template, which keeps its name, into Workspace.
local cloudNames = {
	CumulusCloud = true,
	StratusCloud = true,
}

-- ===== STATE =====

local API = {}
API.Presets = Presets
API.QualityNames = { "Performance", "Medium", "Max" }
API.CurrentQuality = "Max"
API.Current = {
	Lighting = "Max",
	Effects = "Max",
	Atmosphere = "Max",
	Clouds = "Max",
	LensFlare = "Max",
	RobloxQuality = "Max",
}

local changedEvent = Instance.new("BindableEvent")
API.Changed = changedEvent.Event -- fires (categoryName, qualityName)

local hiddenClouds = {}
local seenClouds = setmetatable({}, { __mode = "k" })
local cloudRefreshQueued = false
local cloudWatcher = nil

-- ===== APPLIERS =====

local function applyProperties(targetInstance, properties)
	for propertyName, value in pairs(properties) do
		pcall(function()
			targetInstance[propertyName] = value
		end)
	end
end

local function applyToLightingChildren(className, properties)
	for _, child in ipairs(Lighting:GetChildren()) do
		if child.ClassName == className then
			applyProperties(child, properties)
		end
	end
end

local function applyLighting(preset)
	applyProperties(Lighting, preset)
end

local function applyEffects(preset)
	for className, properties in pairs(preset) do
		applyToLightingChildren(className, properties)
	end
end

local function applyAtmosphere(preset)
	applyToLightingChildren("Atmosphere", preset)
end

local function getCloudLayers()
	local layers = {}
	for _, child in ipairs(Workspace:GetChildren()) do
		if cloudNames[child.Name] and child:IsA("BasePart") then
			seenClouds[child] = true
			table.insert(layers, child)
		end
	end
	table.sort(layers, function(layerA, layerB)
		return layerA.Position.Y < layerB.Position.Y
	end)
	return layers
end

local function restoreHiddenClouds()
	for _, layer in ipairs(hiddenClouds) do
		pcall(function()
			layer.Parent = Workspace
		end)
	end
	table.clear(hiddenClouds)
end

local function applyClouds(preset)
	restoreHiddenClouds()

	for layerIndex, layer in ipairs(getCloudLayers()) do
		layer.CastShadow = preset.CastShadow

		if layer:IsA("MeshPart") then
			layer.RenderFidelity = preset.RenderFidelity
		end
		for _, descendant in ipairs(layer:GetDescendants()) do
			if descendant:IsA("MeshPart") then
				descendant.RenderFidelity = preset.RenderFidelity
			end
		end

		if preset.Step > 1 and (layerIndex - 1) % preset.Step ~= 0 then
			table.insert(hiddenClouds, layer)
			layer.Parent = nil
		end
	end
end

local function applyLensFlare(preset)
	local flareSystem = _G.LensFlareSystem
	if not flareSystem then
		warn("[GraphicsAPI] _G.LensFlareSystem not found, run Sunset_3 first")
		return
	end

	flareSystem.Enabled = preset.Enabled
	flareSystem.SkyFlareEnabled = preset.SkyFlareEnabled
	if flareSystem.Config then
		flareSystem.Config.RaycastSamples = preset.RaycastSamples
	end
end

local function applyRobloxQuality(qualityLevel)
	pcall(function()
		UserSettings():GetService("UserGameSettings").SavedQualityLevel = qualityLevel
	end)
end

local categoryAppliers = {
	Lighting = applyLighting,
	Effects = applyEffects,
	Atmosphere = applyAtmosphere,
	Clouds = applyClouds,
	LensFlare = applyLensFlare,
	RobloxQuality = applyRobloxQuality,
}

-- ===== HELPERS =====

local function refreshOverallQuality()
	local firstName = API.Current[categoryOrder[1]]
	for _, categoryName in ipairs(categoryOrder) do
		if API.Current[categoryName] ~= firstName then
			API.CurrentQuality = "Custom"
			return
		end
	end
	API.CurrentQuality = firstName
end

-- ===== PUBLIC API =====

-- Applies one category ("Lighting", "Effects", "Atmosphere", "Clouds",
-- "LensFlare", "RobloxQuality") at one quality ("Performance", "Medium", "Max").
function API:SetCategory(categoryName, qualityName)
	local applier = categoryAppliers[categoryName]
	local categoryPresets = Presets[categoryName]
	local preset = categoryPresets and categoryPresets[qualityName]

	if not applier or preset == nil then
		warn("[GraphicsAPI] Unknown category/quality: " .. tostring(categoryName) .. " / " .. tostring(qualityName))
		return false
	end

	applier(preset)
	API.Current[categoryName] = qualityName
	refreshOverallQuality()
	changedEvent:Fire(categoryName, qualityName)
	return true
end

-- Applies every category at once.
function API:SetQuality(qualityName)
	if not Presets.Lighting[qualityName] then
		warn("[GraphicsAPI] Unknown quality: " .. tostring(qualityName) .. " (use Performance, Medium or Max)")
		return false
	end

	for _, categoryName in ipairs(categoryOrder) do
		API:SetCategory(categoryName, qualityName)
	end

	API.CurrentQuality = qualityName
	changedEvent:Fire("All", qualityName)
	return true
end

function API:SetLighting(qualityName)
	return API:SetCategory("Lighting", qualityName)
end

function API:SetEffects(qualityName)
	return API:SetCategory("Effects", qualityName)
end

function API:SetAtmosphere(qualityName)
	return API:SetCategory("Atmosphere", qualityName)
end

function API:SetClouds(qualityName)
	return API:SetCategory("Clouds", qualityName)
end

function API:SetLensFlare(qualityName)
	return API:SetCategory("LensFlare", qualityName)
end

function API:SetRobloxQuality(qualityName)
	return API:SetCategory("RobloxQuality", qualityName)
end

-- Individual toggles. effectName: "ColorCorrection", "SunRays", "Bloom", "DepthOfField".
-- These mark the category as "Custom" until a preset is applied again.
function API:SetEffectEnabled(effectName, enabled)
	local className = effectClassNames[effectName]
	if not className then
		warn("[GraphicsAPI] Unknown effect: " .. tostring(effectName))
		return false
	end

	applyToLightingChildren(className, { Enabled = enabled })
	API.Current.Effects = "Custom"
	refreshOverallQuality()
	changedEvent:Fire("Effects", "Custom")
	return true
end

function API:SetShadows(enabled)
	Lighting.GlobalShadows = enabled
	API.Current.Lighting = "Custom"
	refreshOverallQuality()
	changedEvent:Fire("Lighting", "Custom")
	return true
end

function API:GetQuality()
	return API.CurrentQuality
end

-- Returns a copy of { Lighting = "Max", Effects = "Medium", ... }.
function API:GetCurrent()
	local copy = {}
	for categoryName, qualityName in pairs(API.Current) do
		copy[categoryName] = qualityName
	end
	return copy
end

function API:GetPreset(categoryName, qualityName)
	local categoryPresets = Presets[categoryName]
	return categoryPresets and categoryPresets[qualityName]
end

-- Reapplies whatever is currently selected. Call after Sunset_3 respawns
-- effects or clouds, or after editing a preset table live.
function API:Refresh()
	for _, categoryName in ipairs(categoryOrder) do
		local qualityName = API.Current[categoryName]
		local categoryPresets = Presets[categoryName]
		if categoryPresets[qualityName] ~= nil then
			categoryAppliers[categoryName](categoryPresets[qualityName])
		end
	end
end

function API:Destroy()
	if cloudWatcher then
		cloudWatcher:Disconnect()
		cloudWatcher = nil
	end
	restoreHiddenClouds()
	changedEvent:Destroy()
end

-- ===== CLOUD WATCHER =====
-- Sunset_3 spawns its clouds on a task.spawn after WaitForChild, so they can
-- appear after this module loads. When new layers show up, the selected cloud
-- preset is applied to them once things settle.

cloudWatcher = Workspace.ChildAdded:Connect(function(child)
	if not cloudNames[child.Name] or seenClouds[child] then
		return
	end
	if cloudRefreshQueued then
		return
	end

	cloudRefreshQueued = true
	task.delay(0.5, function()
		cloudRefreshQueued = false
		local qualityName = API.Current.Clouds
		local preset = Presets.Clouds[qualityName]
		if preset then
			applyClouds(preset)
		end
	end)
end)

-- ===== REGISTER =====

environment.GraphicsAPI = API
_G.GraphicsAPI = API

if previousQuality and previousQuality ~= "Custom" and Presets.Lighting[previousQuality] then
	API:SetQuality(previousQuality)
end

return API

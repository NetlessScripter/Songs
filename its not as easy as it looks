local function writeProps(lines, varName, obj, props)
	for _, prop in ipairs(props) do
		if prop ~= "Name" then
			local ok, val = pcall(function() return obj[prop] end)
			if ok and val ~= nil then
				local sv = vStr(val)
				if sv then
					table.insert(lines, varName.."."..prop.."="..sv.."\n")
				end
			end
		end
	end
end

local function getVarName(idx)
	return "obj"..idx
end

local objCounter = {0}
local function newVar()
	objCounter[1] = objCounter[1] + 1
	return "obj"..objCounter[1]
end

local function serializeAttachments(lines, obj, parentVar)
	for _, child in ipairs(obj:GetChildren()) do
		if child:IsA("Attachment") then
			local av = newVar()
			table.insert(lines, "local "..av.."=Instance.new('Attachment')\n")
			local ok, pos = pcall(function() return child.Position end)
			if ok then table.insert(lines, av..".Position="..vStr(pos).."\n") end
			local ok2, ori = pcall(function() return child.Orientation end)
			if ok2 then table.insert(lines, av..".Orientation="..vStr(ori).."\n") end
			local ok3, name = pcall(function() return child.Name end)
			if ok3 then table.insert(lines, av..".Name="..vStr(name).."\n") end
			table.insert(lines, av..".Parent="..parentVar.."\n")
		end
	end
end

local function serializeModelChildren(lines, obj, parentVar, modelCF)

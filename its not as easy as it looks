			local v = newVar()
			table.insert(lines, "local "..v.."=Instance.new('MeshPart')\n")
			writeProps(lines, v, child, meshPartProps)
			local ok, cf = pcall(function() return child.CFrame end)
			if ok then
				local relCF = modelCF:Inverse() * cf
				table.insert(lines, v..".CFrame=anchorCF*"..vStr(relCF).."\n")
			end
			table.insert(lines, v..".Parent="..parentVar.."\n")
			serializeAttachments(lines, child, v)
			serializeModelChildren(lines, child, v, modelCF)

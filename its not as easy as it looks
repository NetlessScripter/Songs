for _, emitter in ipairs(emitters) do
	table.insert(s,"do\n")
	table.insert(s,"local e=Instance.new('ParticleEmitter')\n")
	for _, prop in ipairs(emitterProps) do
		if prop ~= "Name" then
			local ok, val = pcall(function() return emitter[prop] end)
			if ok and val ~= nil then
				local sv = vStr(val)
				if sv then
					table.insert(s,"e."..prop.."="..sv.."\n")
				end
			end
		end
	end
	table.insert(s,"e:Emit(15)\n")
	table.insert(s,"e.Parent=part\n")
	table.insert(s,"end\n")
end

table.insert(s,"end\n")

setclipboard(table.concat(s))
